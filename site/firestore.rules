rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helpers ----
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'customer')
        : 'customer';
    }

    function isAdmin() {
      return isSignedIn() && getUserRole() == 'admin';
    }

    function isStaff() {
      return isSignedIn() && (getUserRole() in ['admin', 'kitchen', 'bucatar', 'staff', 'ospatar', 'manager', 'delivery']);
    }

    function hasSafeLoyaltyDefaults() {
      return request.resource.data.get('balance', 0) == 0
        && request.resource.data.get('vipPoints', 0) == 0
        && request.resource.data.get('stamps', 0) == 0
        && request.resource.data.get('birthdayVoucherActive', false) == false;
    }

    // ---- Users / loyalty ----
    // Users can read/write their own profile. Admins can read/write any profile.
    // A user may never grant themselves the admin role.
    match /users/{userId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow create: if isSignedIn() && request.auth.uid == userId
        && (!('role' in request.resource.data) || request.resource.data.role == 'customer')
        && hasSafeLoyaltyDefaults();
      allow update: if isAdmin()
        || (isSignedIn() && request.auth.uid == userId
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['name', 'phone', 'email', 'birthday', 'updatedAt']));
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
    }

    // ---- Admin-managed catalog (public read of active items) ----
    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /promotions/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /locations/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /tables/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /siteContent/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /articles/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /candyBarItems/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- Reviews: public read of approved, anyone may submit (unapproved) ----
    match /reviews/{id} {
      allow read: if true;
      allow create: if request.resource.data.approved == false;
      allow update, delete: if isAdmin();
    }

    // ---- Orders: a user creates their own; staff/kitchen/admin manage all ----
    match /orders/{id} {
      allow read: if isStaff() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    // ---- Reservations: a user creates their own; staff/admin manage all ----
    match /reservations/{id} {
      allow read: if isStaff() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    // ---- Offer / event requests: anyone may submit; admins manage ----
    match /offerRequests/{id} {
      allow read: if isAdmin();
      allow create: if request.resource.data.status == 'new';
      allow update, delete: if isAdmin();
    }

    // ---- Push Notifications & Campaigns ----
    match /notifications/{id} {
      allow read: if isAdmin() || (isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.target == 'all'));
      allow create, update, delete: if isAdmin();
    }

    // ---- Push device tokens ----
    match /pushTokens/{id} {
      allow read: if isAdmin();
      allow write: if isSignedIn();
    }
  }
}
